# ============================================================
# TB Detection System - Plantilla de variables de entorno
# Copia este archivo a .env y reemplaza los valores.
# Nunca versiones el archivo .env real.
# ============================================================

# --- Flask ---
# development | production
FLASK_CONFIG=development

# Genera una clave segura, por ejemplo:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# --- Base de datos ---
# Desarrollo (SQLite):
DATABASE_URL=sqlite:///instance/tb_detection.db

# Produccion (PostgreSQL, requiere driver psycopg2):
# DATABASE_URL=postgresql://user:password@localhost:5432/tb_detection

# --- API del modelo remoto (integracion prevista) ---
# El modelo se entrena y exporta en TB-prediction-model.
MODEL_API_URL=http://127.0.0.1:8000
MODEL_API_KEY=replace-with-model-api-key
MODEL_API_TIMEOUT=30
